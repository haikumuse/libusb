/* config.h — generated by CMake for MinGW builds of libusb event-abstraction-v4 */
#ifndef LIBUSB_CONFIG_H
#define LIBUSB_CONFIG_H

/* Define to the attribute for default visibility. */
#define DEFAULT_VISIBILITY

/* Define to 1 to start with debug message logging enabled. */
/* #undef ENABLE_DEBUG_LOGGING */

/* Define to 1 to enable message logging. */
#define ENABLE_LOGGING 1

/* Define to 1 if you have the <sys/time.h> header file. */
#define HAVE_SYS_TIME_H 1

/* Define to 1 if you have the `gettimeofday' function. */
#define HAVE_GETTIMEOFDAY 1

/* Define to 1 if the OS provides a timer source for event handling. */
#define HAVE_OS_TIMER 1

/* Define to 1 if compiling for a Windows platform. */
#define OS_WINDOWS 1

/* Define to the attribute for enabling parameter checks on printf-like functions. */
#define PRINTF_FORMAT(a, b)

/* Define to 1 to output logging messages to the systemwide log. */
/* #undef USE_SYSTEM_LOGGING_FACILITY */

#endif /* LIBUSB_CONFIG_H */
